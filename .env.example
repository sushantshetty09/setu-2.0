# Server Configuration
PORT=3000
NODE_ENV=development

# WhatsApp Cloud API Credentials (from Meta App Dashboard)
# Graph API access token (System User or Temporary Access Token)
WHATSAPP_TOKEN=your_meta_system_user_or_temporary_access_token_here

# Phone Number ID (from WhatsApp > API Setup in Meta Developer Dashboard)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Webhook Verification Token (custom string configured in Webhooks settings in Meta Dashboard)
WHATSAPP_VERIFY_TOKEN=scheme_saathi_webhook_token_2025

# Meta App Secret (from App settings > Basic in Meta Developer Dashboard, used to verify x-hub-signature-256)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# WhatsApp Cloud API Graph Version
WHATSAPP_API_VERSION=v21.0

# Teammates' Scheme Matching Backend API
# When SCHEME_SERVICE_MODE=api, Scheme Saathi sends user profiles to this base URL
BACKEND_API_URL=http://localhost:4000
BACKEND_API_TIMEOUT_MS=5000

# Scheme Service Mode: 'mock' uses local verified sample scheme catalogue, 'api' connects to teammate's backend
SCHEME_SERVICE_MODE=mock

# Google Gemini AI Configuration (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
